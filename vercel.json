{
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/chat-completions.js": {
      "maxDuration": 60
    },
    "api/models.js": {
      "maxDuration": 60
    },
    "api/images-generate.js": {
      "maxDuration": 60
    },
    "api/tts.js": {
      "maxDuration": 60
    },
    "api/vision-analyze.js": {
      "maxDuration": 60
    },
    "api/music163/[action].js": {
      "maxDuration": 60
    },
    "api/music-audio-proxy.js": {
      "maxDuration": 60
    },
    "api/music-image-proxy.js": {
      "maxDuration": 60
    }
  }
}
